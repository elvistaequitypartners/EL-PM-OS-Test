# Environment variables — never commit credentials
.env
.env.local
.env.*
!.env.example

# Outputs generated by PM Operating System commands
outputs/

# Personal memory — never committed; belongs to the individual PM
memory/personal/*
!memory/personal/.gitkeep
!memory/personal/README.md

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
*.swp

# Python bytecode from scripts/
__pycache__/
*.pyc
