# PM Operating System — per-user secrets
# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# ---------------------------------------------------------------------------
# Tracker credentials — used by MCP servers and by scripts/sync_trackers.py
# ---------------------------------------------------------------------------

# Linear — https://linear.app/settings/api
LINEAR_API_KEY=lin_api_xxxxxxxxxxxx

# Jira — https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL=https://your-company.atlassian.net
JIRA_EMAIL=you@vistaequitypartners.com
JIRA_API_TOKEN=xxxxxxxxxxxx

# Notion — https://www.notion.so/my-integrations
NOTION_API_KEY=secret_xxxxxxxxxxxx

# Slack — https://api.slack.com/apps → Bot Token
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx
SLACK_TEAM_ID=Txxxxxxxx

# GitHub — https://github.com/settings/tokens (fine-grained recommended)
GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# ---------------------------------------------------------------------------
# PM Operating System identity
# ---------------------------------------------------------------------------

# Override the team resolved from .pm-os.yaml. Useful when one PM manages
# multiple team scopes and needs to switch per session.
# PM_TEAM=platform

# Optional: override the personal profile filename. Defaults to the local part
# of your git user.email — you usually don't need to set this.
# PM_USER=elandon
